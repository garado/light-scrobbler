+package com.thelightphone.sdk.media
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.media.MediaMetadata
+import android.media.session.MediaController
+import android.media.session.MediaSessionManager
+import android.media.session.PlaybackState
+import android.provider.Settings
+import android.service.notification.NotificationListenerService
+import android.service.notification.StatusBarNotification
+import com.thelightphone.sdk.SealedLightContext
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** Now-playing metadata read from the OS's active [MediaController]s. */
+data class LightNowPlayingTrack(
+    val artist: String?,
+    val title: String?,
+    val album: String?,
+    val isPlaying: Boolean,
+)
+
+/** Device-wide now-playing state. Needs the `media-session-access` capability + user grant via [requestAccess]. */
+object LightMediaSessionAccess {
+    private val _nowPlaying = MutableStateFlow<LightNowPlayingTrack?>(null)
+    val nowPlaying: StateFlow<LightNowPlayingTrack?> = _nowPlaying.asStateFlow()
+
+    /** Whether the user has granted this tool notification-listener access. */
+    fun isGranted(lightContext: SealedLightContext): Boolean {
+        val context = lightContext.androidContext
+        val flat = Settings.Secure.getString(
+            context.contentResolver,
+            "enabled_notification_listeners",
+        )
+        return flat.orEmpty().split(":").any {
+            ComponentName.unflattenFromString(it)?.packageName == context.packageName
+        }
+    }
+
+    /** Opens the OS settings screen where the user can grant listener access. */
+    fun requestAccess(lightContext: SealedLightContext) {
+        lightContext.androidContext.startActivity(
+            Intent(Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS)
+        )
+    }
+
+    internal fun update(controllers: List<MediaController>) {
+        val active = controllers.firstOrNull { it.playbackState?.state == PlaybackState.STATE_PLAYING }
+            ?: controllers.firstOrNull()
+        val metadata = active?.metadata
+
+        _nowPlaying.value = if (active == null || metadata == null) {
+            null
+        } else {
+            LightNowPlayingTrack(
+                artist = metadata.getString(MediaMetadata.METADATA_KEY_ARTIST),
+                title = metadata.getString(MediaMetadata.METADATA_KEY_TITLE),
+                album = metadata.getString(MediaMetadata.METADATA_KEY_ALBUM),
+                isPlaying = active.playbackState?.state == PlaybackState.STATE_PLAYING,
+            )
+        }
+    }
+
+    internal fun clear() {
+        _nowPlaying.value = null
+    }
+}
+
+/** Notification listener for fetching [MediaSessionManager.getActiveSessions] */
+class LightMediaSessionListenerService : NotificationListenerService() {
+
+    // OnActiveSessionsChangedListener only fires when the set of active sessions
+    // changes, not when a controller's own track/playback state changes (e.g.
+    // skipping to the next song within the same session), so each controller also
+    // gets its own callback to catch those in-session updates.
+    private var trackedControllers: List<MediaController> = emptyList()
+    private val controllerCallbacks = mutableMapOf<MediaController, MediaController.Callback>()
+
+    private val sessionsChangedListener =
+        MediaSessionManager.OnActiveSessionsChangedListener { controllers ->
+            trackControllers(controllers.orEmpty())
+        }
+
+    private fun trackControllers(controllers: List<MediaController>) {
+        val previous = trackedControllers
+        for (controller in previous) {
+            if (controller !in controllers) {
+                controllerCallbacks.remove(controller)?.let { controller.unregisterCallback(it) }
+            }
+        }
+        for (controller in controllers) {
+            if (controller !in controllerCallbacks) {
+                val callback = object : MediaController.Callback() {
+                    override fun onMetadataChanged(metadata: MediaMetadata?) {
+                        LightMediaSessionAccess.update(trackedControllers)
+                    }
+
+                    override fun onPlaybackStateChanged(state: PlaybackState?) {
+                        LightMediaSessionAccess.update(trackedControllers)
+                    }
+
+                    override fun onSessionDestroyed() {
+                        controllerCallbacks.remove(controller)
+                    }
+                }
+                controller.registerCallback(callback)
+                controllerCallbacks[controller] = callback
+            }
+        }
+        trackedControllers = controllers
+        LightMediaSessionAccess.update(controllers)
+    }
+
+    override fun onListenerConnected() {
+        super.onListenerConnected()
+        val manager = getSystemService(Context.MEDIA_SESSION_SERVICE) as MediaSessionManager
+        val component = ComponentName(this, LightMediaSessionListenerService::class.java)
+        manager.addOnActiveSessionsChangedListener(sessionsChangedListener, component)
+        trackControllers(manager.getActiveSessions(component))
+    }
+
+    override fun onListenerDisconnected() {
+        super.onListenerDisconnected()
+        val manager = getSystemService(Context.MEDIA_SESSION_SERVICE) as MediaSessionManager
+        manager.removeOnActiveSessionsChangedListener(sessionsChangedListener)
+        controllerCallbacks.forEach { (controller, callback) -> controller.unregisterCallback(callback) }
+        controllerCallbacks.clear()
+        trackedControllers = emptyList()
+        LightMediaSessionAccess.clear()
+    }
+
+    override fun onNotificationPosted(sbn: StatusBarNotification) {}
+    override fun onNotificationRemoved(sbn: StatusBarNotification) {}
+}
